---
import MainLayout from '@/components/layout/MainLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionIntro from '@/components/ui/SectionIntro.astro';
import { aboutContent } from '@/data/company';
---

<MainLayout
  title="Nosotros"
  description="Conozca el enfoque, misión, visión y valores de SmarSoFT como socio tecnológico para proyectos de software y consultoría."
  pathname="/nosotros"
>
  <section class="py-20 sm:py-24">
    <Container>
      <SectionIntro
        eyebrow="Nosotros"
        title="Una base clara para construir relaciones, soluciones y entregas confiables."
        description="En SmarSoFT entendemos la tecnología como un medio para resolver necesidades reales con criterio técnico, orden operativo y compromiso con el resultado."
      />

      <article class="surface-card mt-12 p-8 sm:p-10">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
          <div>
            <span class="eyebrow">Enfoque</span>
            <h2 class="mt-4 text-3xl font-bold tracking-tight">Cómo entendemos nuestro trabajo</h2>
            <p class="mt-5 text-lg leading-8 text-slate-600">{aboutContent.approach}</p>
          </div>
          <div class="grid gap-6 md:grid-cols-2">
            <article class="rounded-[1.75rem] border border-slate-200 bg-slate-50/90 p-7">
              <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-700">Misión</p>
              <p class="mt-4 leading-8 text-slate-600">{aboutContent.mission}</p>
            </article>
            <article class="rounded-[1.75rem] border border-slate-200 bg-slate-50/90 p-7">
              <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-700">Visión</p>
              <p class="mt-4 leading-8 text-slate-600">{aboutContent.vision}</p>
            </article>
          </div>
        </div>
      </article>

      <div class="mt-12">
        <SectionIntro
          eyebrow="Valores"
          title="Principios que sostienen nuestra forma de colaborar y entregar."
          description="Más que declaraciones, son criterios operativos que buscamos reflejar en la relación con el cliente y en la ejecución diaria."
        />

        <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {
            aboutContent.values.map((value) => (
              <article class="surface-card p-7">
                <h3 class="text-xl font-bold">{value.title}</h3>
                <p class="mt-4 leading-7 text-slate-600">{value.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </Container>
  </section>
</MainLayout>
